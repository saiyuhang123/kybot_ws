<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_rviz_panel</name>
  <version>0.0.0</version>
  <description>RViz2 Panel for waypoint mission planning and Nav2+PTZ+Capture integration</description>
  <maintainer email="your_email@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 依赖项声明 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>std_srvs</depend>
  <depend>hk_camera</depend>
  <depend>trash_mission_interfaces</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- 向 RViz2 注册插件配置文件 -->
    <rviz_common plugin="${prefix}/plugins_description.xml"/>
  </export>
</package>
